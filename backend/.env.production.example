# =============================================================================
# MYCO CAUSAS v2 — VARIABLES DE ENTORNO PARA PRODUCCIÓN (AWS EC2 / LIGHTSAIL / RDS)
# Copia este archivo a ".env" en tu servidor AWS y reemplaza los valores sensibles.
# =============================================================================

# Puerto de escucha del backend
PORT=5000
NODE_ENV=production

# Base de datos MySQL (Si usas AWS RDS, coloca el Endpoint aquí; si es local en EC2, usa localhost o 127.0.0.1)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CambiarPorTuPasswordSeguro123!*
DB_NAME=myco_causas_v2

# Clave criptográfica para firmas de JWT (genera una cadena aleatoria de 64 caracteres)
JWT_SECRET=myco_causas_super_secret_jwt_key_2026_prod_alexis_aws_secure
JWT_EXPIRES_IN=24h

# URL pública de tu frontend en producción (tu dominio o IP pública de EC2)
# Ejemplo: https://mycocausas.pe o http://3.85.120.45
FRONTEND_URL=https://tudominio.com
